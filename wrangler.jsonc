/**
 * Wrangler configuration: https://developers.cloudflare.com/workers/wrangler/configuration/
 * Secrets (GOOGLE_PLACES_API_KEY, DEEPSEEK_API_KEY) go in `.dev.vars` locally and
 * `wrangler secret put` in production, never here.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nelcota-leads",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    "AI_MODEL_ANALYSIS": "deepseek-flash",
    "AI_MODEL_MESSAGE": "deepseek-v4-pro",
    // Max billable Google Places requests per day (Brazil time); each returns up to 20 places.
    "PLACES_DAILY_REQUEST_LIMIT": "50",
  },
  // Hourly tick for the autopilot: it searches once a day at the configured hour and
  // writes follow-up reminders as they come due.
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nelcota-leads",
      // Replace with the id printed by `wrangler d1 create nelcota-leads` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "queues": {
    "producers": [{ "binding": "LEAD_QUEUE", "queue": "nelcota-leads-analysis" }],
    "consumers": [
      {
        "queue": "nelcota-leads-analysis",
        // Each message reads one site and makes up to two LLM calls; keep the fan-out modest.
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_concurrency": 3,
        // Must exceed MAX_ATTEMPTS in src/server/process-lead.ts so failures get recorded.
        "max_retries": 5,
        "dead_letter_queue": "nelcota-leads-analysis-dlq",
      },
      // Marks leads whose messages exhausted every retry, so searches always finish.
      { "queue": "nelcota-leads-analysis-dlq", "max_batch_size": 10, "max_retries": 2 },
    ],
  },
}
