{
  "name": "nelcota-leads",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "oxlint --type-aware --type-check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nelcota-leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply nelcota-leads --remote",
    "cf-typegen": "wrangler types",
    "prepare": "lefthook install",
    "test:e2e": "playwright test",
    "account:seed": "node scripts/seed-account.ts",
    "services:seed": "node scripts/seed-services.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.86",
    "@fontsource/urbanist": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.169.4",
    "ai": "^7.0.172",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "libphonenumber-js": "^1.13.16",
    "linkedom": "^0.18.15",
    "papaparse": "^5.7.1",
    "postal-mime": "^4.2.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@iconify-json/solar": "^1.2.15",
    "@playwright/test": "^1.65.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "shadcn": "4.23.0",
    "typescript": "^7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
